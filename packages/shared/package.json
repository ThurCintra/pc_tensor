{
  "name": "shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "gen:jsonschema": "tsc -p tsconfig.build.json && node scripts/gen-jsonschema.mjs"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "quicktype-core": "^26.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "zod-to-json-schema": "^3.25.2"
  }
}
