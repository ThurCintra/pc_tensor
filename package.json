{
  "name": "pc-sentinel",
  "version": "0.1.0",
  "description": "Monitor de hardware para Windows: temperaturas reais, processos, histórico térmico e acesso pelo celular.",
  "keywords": [
    "electron",
    "hardware-monitor",
    "temperature",
    "windows",
    "librehardwaremonitor",
    "react"
  ],
  "homepage": "https://github.com/ThurCintra/pc_tensor#readme",
  "bugs": {
    "url": "https://github.com/ThurCintra/pc_tensor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThurCintra/pc_tensor.git"
  },
  "license": "MIT",
  "author": "ThurCintra (https://github.com/ThurCintra)",
  "private": true,
  "main": "src/main/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n \"vite,electron\" -c \"cyan,magenta\" \"npm run dev:vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:vite": "vite",
    "start": "npm run build && electron .",
    "build": "vite build",
    "build:bridge": "node scripts/build-bridge.js",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "systeminformation": "^5.25.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "^0.475.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.pcsentinel.app",
    "productName": "PC Sentinel",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "src/server/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/sensor-bridge",
        "to": "sensor-bridge",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "PC Sentinel",
      "artifactName": "PC-Sentinel-Setup.${ext}",
      "include": "build/installer.nsh"
    }
  }
}
