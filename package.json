{
  "name": "pc-sentinel",
  "version": "0.1.0",
  "description": "Monitoramento em tempo real de hardware, temperaturas e streaming ao vivo para dispositivos móveis.",
  "main": "src/main/main.js",
  "type": "commonjs",
  "author": "Arthur",
  "scripts": {
    "dev": "concurrently -k -n \"vite,electron\" -c \"cyan,magenta\" \"npm run dev:vite\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "electron src/main/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "start": "electron src/main/main.js",
    "dist:installer": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.14.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.25.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.475.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.pcsentinel.app",
    "productName": "PC Sentinel",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "src/server/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "src/server/public/**/*"
    ],
    "extraResources": [
      {
        "from": "tools/LibreHardwareMonitor",
        "to": "tools/LibreHardwareMonitor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "PC Sentinel",
      "artifactName": "PC-Sentinel-Setup.${ext}",
      "include": "build/installer.nsh"
    }
  }
}
