# Database (TimescaleDB / PostgreSQL). No real secrets here.
POSTGRES_USER=pcsentinel
POSTGRES_PASSWORD=pcsentinel_dev_password
POSTGRES_DB=pcsentinel
POSTGRES_PORT=5432

# Backend. Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgres://pcsentinel:pcsentinel_dev_password@localhost:5432/pcsentinel
DATABASE_URL_TEST=postgres://pcsentinel:pcsentinel_dev_password@localhost:5432/pcsentinel_test
PORT=3000
HOST=0.0.0.0
JWT_SECRET=change-me-to-at-least-32-random-characters
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info
